# Copy to .env for local development. `npm run dev` loads it automatically.
# Overrides the vault path from the config file.
DIBUJO_VAULT_PATH=/absolute/path/to/your/obsidian/vault

# Point config at a scratch folder so development never touches your real config.
# XDG_CONFIG_HOME=/absolute/path/to/scratch/config

# Print stack traces for internal errors.
# DIBUJO_DEBUG=1
